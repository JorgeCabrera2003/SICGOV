{
    "name": "jorge/good-vibes",
    "description": "Sistema MVC para la gestion de un restaurante",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "config/modulo_sistema.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "dompdf/dompdf": "^3.0",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6",
        "php-units-of-measure/php-units-of-measure": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "optimize-autoloader": true
    }
}
